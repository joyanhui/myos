{
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 8,
  "modules-left": ["niri/workspaces", "hyprland/workspaces"],
  "modules-center": ["niri/window", "hyprland/window"],
  "modules-right": ["cpu", "temperature", "memory", "network", "battery", "backlight", "tray", "pulseaudio", "custom/weather", "custom/lunar"],
  "niri/workspaces": {
    "all-outputs": false,
    "format": "{index}",
    "disable-scroll": true
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 80
  },
  "cpu": {
    "interval": 2,
    "format": "<span font='16'>󰻠</span> {usage}%",
    "tooltip": true
  },
  "temperature": {
    "interval": 2,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "format": "<span font='16'>󰔏</span> {temperatureC}°C",
    "tooltip": true
  },
  "memory": {
    "interval": 10,
    "format": "<span font='16'>󰍛</span> {percentage}%",
    "tooltip": true
  },
  "network": {
    "interface": "wlo*",
    "format-wifi": "<span font='16'>󰤨</span> {essid} {signalStrength}%",
    "format-ethernet": "<span font='16'>󰈀</span> {ifname}",
    "format-linked": "<span font='16'>󰤭</span> {ifname}",
    "format-disconnected": "<span font='16'>󰤭</span> offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span font='16'>{icon}</span> {capacity}%",
    "format-charging": "<span font='16'>󱐋</span> {capacity}%",
    "format-plugged": "<span font='16'>󰚥</span> {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"],
    "tooltip": true
  },
  "backlight": {
    "format": "<span font='16'>◐</span> {percent}%",
    "scroll-step": 5,
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": false,
    "icon-theme": "Papirus-Dark",
    "icons": {
      "Fcitx": "input-keyboard",
      "StatusNotifierItem": "kdeconnectindicatordark"
    }
  },

  "pulseaudio": {
    "format": "<span font='16'>󰕾</span> {volume}%",
    "format-muted": "<span font='16'>󰝟</span> muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "max-volume": 100,
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "custom/weather": {
    "exec": "bar-weather --waybar",
    "interval": 30,
    "return-type": "json",
    "tooltip": true,
    "on-click": "bar-weather --detail",
    "on-click-middle": "bar-weather --picker",
    "on-scroll-up": "bar-weather --prev",
    "on-scroll-down": "bar-weather --next"
  },
  "custom/lunar": {
    "exec": "bar-lunar",
    "interval": 2,
    "format": "<span font='16'>󰥔</span>  {}",
    "tooltip-format": "点击打开万年历",
    "on-click": "xdg-open https://www.51wnl.com/webcalandar/index.html"
  }
}
