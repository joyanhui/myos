
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
}

cursor {
    xcursor-theme "__CURSOR_THEME__"
}

output "eDP-1" {
    scale 1
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.4; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.4
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 3
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    border {
        off
    }
    shadow {
        on
        softness 20
        spread 3
        offset x=0 y=4
        color "#0007"
    }
}

prefer-no-csd
   hotkey-overlay {
       hide-not-bound
   }

window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^brave-.*-Default$"#
    open-floating true
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "ironbar"
spawn-sh-at-startup "wallpaper=$(find \"$(dirname \"$(readlink -f \"$HOME/.config/niri/config.kdl\")\")/../static_file/wallpaper\" -type f -name '*.mp4' | shuf -n 1); [ -n \"$wallpaper\" ] && mpvpaper --auto-pause -o 'no-audio loop panscan=1 hwdec=auto-safe vf=fps=30' '*' \"$wallpaper\" &"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user restart fcitx5"
spawn-sh-at-startup "swayidle -w timeout 1800 'swaylock -f' timeout 2700 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'swaylock -f'"
spawn-sh-at-startup "dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user restart xdg-desktop-portal"

binds {
    Mod+Shift+Slash hotkey-overlay-title="hotkey overlay | 显示快捷键列表" { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="terminal (ghostty) | 终端 (ghostty)" { spawn "ghostty"; }
    Mod+Shift+Return hotkey-overlay-title="random background terminal (ghostty) | 随机背景终端 (ghostty)" { spawn "ghostty-random-bg"; }
    Mod+Shift+E hotkey-overlay-title="file manager (thunar) | 文件管理器 (thunar)" { spawn "thunar"; }
    Mod+Shift+B hotkey-overlay-title="web browser (brave) | 浏览器 (brave)" { spawn "brave"; }
    Mod+Ctrl+Shift+Return hotkey-overlay-title="terminal (kitty) | 终端 (kitty)" { spawn "kitty"; }
    Mod+Shift+R hotkey-overlay-title="app launcher | 应用启动器" { spawn "rofi" "-show" "drun"; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="restart input method (fcitx5) | 重启输入法 (fcitx5)" { spawn "systemctl" "--user" "restart" "fcitx5"; }
    Mod+Shift+Q repeat=false hotkey-overlay-title="close window | 关闭窗口" { close-window; }
    Mod+Ctrl+Shift+E hotkey-overlay-title="quit niri | 退出 niri" { quit; }

    Mod+Shift+1 hotkey-overlay-title="focus workspace 1 | 聚焦工作区 1" { focus-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="focus workspace 2 | 聚焦工作区 2" { focus-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="focus workspace 3 | 聚焦工作区 3" { focus-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title="focus workspace 4 | 聚焦工作区 4" { focus-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title="focus workspace 5 | 聚焦工作区 5" { focus-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title="focus workspace 6 | 聚焦工作区 6" { focus-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title="focus workspace 7 | 聚焦工作区 7" { focus-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title="focus workspace 8 | 聚焦工作区 8" { focus-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title="focus workspace 9 | 聚焦工作区 9" { focus-workspace 9; }
    Mod+Ctrl+Shift+1 hotkey-overlay-title="move column to workspace 1 | 移动列到工作区 1" { move-column-to-workspace 1; }
    Mod+Ctrl+Shift+2 hotkey-overlay-title="move column to workspace 2 | 移动列到工作区 2" { move-column-to-workspace 2; }
    Mod+Ctrl+Shift+3 hotkey-overlay-title="move column to workspace 3 | 移动列到工作区 3" { move-column-to-workspace 3; }
    Mod+Ctrl+Shift+4 hotkey-overlay-title="move column to workspace 4 | 移动列到工作区 4" { move-column-to-workspace 4; }
    Mod+Ctrl+Shift+5 hotkey-overlay-title="move column to workspace 5 | 移动列到工作区 5" { move-column-to-workspace 5; }
    Mod+Ctrl+Shift+6 hotkey-overlay-title="move column to workspace 6 | 移动列到工作区 6" { move-column-to-workspace 6; }
    Mod+Ctrl+Shift+7 hotkey-overlay-title="move column to workspace 7 | 移动列到工作区 7" { move-column-to-workspace 7; }
    Mod+Ctrl+Shift+8 hotkey-overlay-title="move column to workspace 8 | 移动列到工作区 8" { move-column-to-workspace 8; }
    Mod+Ctrl+Shift+9 hotkey-overlay-title="move column to workspace 9 | 移动列到工作区 9" { move-column-to-workspace 9; }
    Mod+Shift+A hotkey-overlay-title="window switcher | 窗口切换" { spawn "rofi" "-show" "window"; }

    Mod+Shift+Left hotkey-overlay-title="focus column left | 聚焦左列" { focus-column-left; }
    Mod+Shift+Right hotkey-overlay-title="focus column right | 聚焦右列" { focus-column-right; }
    Mod+Shift+Up hotkey-overlay-title="focus window up | 聚焦上方窗口" { focus-window-up; }
    Mod+Shift+Down hotkey-overlay-title="focus window down | 聚焦下方窗口" { focus-window-down; }
    Mod+Shift+WheelScrollUp hotkey-overlay-title="focus column left | 聚焦左列" { focus-column-left; }
    Mod+Shift+WheelScrollDown hotkey-overlay-title="focus column right | 聚焦右列" { focus-column-right; }
    Mod+Ctrl+Shift+Left hotkey-overlay-title="move column left | 移动列到左侧" { move-column-left; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="move column right | 移动列到右侧" { move-column-right; }
    Mod+Ctrl+Shift+Up hotkey-overlay-title="move window up | 移动窗口向上" { move-window-up; }
    Mod+Ctrl+Shift+Down hotkey-overlay-title="move window down | 移动窗口向下" { move-window-down; }

    Mod+Shift+F hotkey-overlay-title="maximize column | 最大化列" { maximize-column; }
    Mod+Ctrl+Shift+F hotkey-overlay-title="fullscreen window | 全屏窗口" { fullscreen-window; }
    Mod+Shift+M hotkey-overlay-title="maximize window to edges | 最大化窗口到边缘" { maximize-window-to-edges; }
    Mod+Shift+V hotkey-overlay-title="toggle clipboard | 切换剪切板" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Ctrl+Shift+V hotkey-overlay-title="switch focus (floating/tiling) | 切换焦点 (浮动/平铺)" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+W hotkey-overlay-title="toggle column tabbed display | 切换列标签显示" { toggle-column-tabbed-display; }
    Mod+Ctrl+Shift+W hotkey-overlay-title="switch preset column width | 切换预设列宽" { switch-preset-column-width; }
    Mod+Shift+H hotkey-overlay-title="reset window height | 重置窗口高度" { reset-window-height; }
    Mod+Minus hotkey-overlay-title="column width -10% | 列宽 -10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="column width +10% | 列宽 +10%" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="window height -10% | 窗口高度 -10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="window height +10% | 窗口高度 +10%" { set-window-height "+10%"; }
    Mod+Comma hotkey-overlay-title="consume window into column | 并入列" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="expel window from column | 移出列" { expel-window-from-column; }
    Mod+BracketLeft hotkey-overlay-title="consume/expel window (left) | 并入/移出列 (左)" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="consume/expel window (right) | 并入/移出列 (右)" { consume-or-expel-window-right; }
    Mod+Shift+C hotkey-overlay-title="center column | 居中列" { center-column; }

    Mod+Shift+O repeat=false hotkey-overlay-title="toggle overview | 切换概览" { toggle-overview; }
    Mod+Shift+P hotkey-overlay-title="screenshot (flameshot) | 截图 (flameshot)" { spawn "flameshot" "gui"; }
    Mod+Ctrl+Shift+P hotkey-overlay-title="select area screenshot (niri) | 自由选取截图 (niri原生截图)" { screenshot; }
    // Mod+Shift+Print hotkey-overlay-title="screenshot screen | 截屏 (屏幕)" { screenshot-screen; }
    // Mod+Ctrl+Shift+Print hotkey-overlay-title="screenshot window | 截屏 (窗口)" { screenshot-window; }

    // Mod+Shift+Escape allow-inhibiting=false hotkey-overlay-title="toggle shortcuts inhibit | 切换快捷键抑制" { toggle-keyboard-shortcuts-inhibit; }
    // Mod+Ctrl+Shift+P hotkey-overlay-title="power off monitors | 关闭显示器" { power-off-monitors; }
}

input {
    mod-key "Alt"
}
