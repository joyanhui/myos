{
  "position": "top",
  "height": 38,
  "start": [
    { "type": "workspaces", "all_monitors": false }
  ],
  "center": [
    { "type": "focused", "icon_size": 16, "truncate": "end" }
  ],
  "end": [
    {
      "type": "sys_info",
      "name": "cpu",
      "format": ["<span size='xx-large'>󰻠</span> {cpu_percent}%"],
      "interval": { "cpu": 2 }
    },
    {
      "type": "sys_info",
      "name": "memory",
      "format": ["<span size='xx-large'>󰍛</span> {memory_percent}%"],
      "interval": { "memory": 10 }
    },
    {
      "type": "network_manager",
      "types_whitelist": ["ethernet", "wifi"],
      "format": "{icon} {ssid} {signal_strength}%",
      "format_disconnected": "󰤭 offline"
    },
    {
      "type": "battery",
      "icon_size": 24,
      "format": "<span size='xx-large'>{icon}</span> {percentage}%",
      "show_if": "ls /sys/class/power_supply/ | grep --quiet '^BAT'"
    },
    {
      "type": "brightness",
      "icon_size": 24,
      "format": "<span size='xx-large'>◐</span>{percentage}%",
      "step": 5
    },
    { "type": "tray" },
    {
      "type": "volume",
      "format": "<span size='xx-large'>{icon}</span> {percentage}%",
      "max_volume": 100,
      "icons": {
        "muted": "󰝟",
        "volume_low": "󰕿",
        "volume_medium": "󰖀",
        "volume_high": "󰕾"
      }
    },
    {
      "type": "custom",
      "name": "weather",
      "class": "weather",
      "disable_popup": true,
      "tooltip": "{{120000:bar-weather --tooltip}}",
      "on_click_left": "bar-weather --detail",
      "on_click_right": "bar-weather --picker",
      "on_scroll_up": "bar-weather --prev",
      "on_scroll_down": "bar-weather --next",
      "bar": [{ "type": "label", "label": "{{10000:bar-weather --text}}" }]
    },
    {
      "type": "label",
      "name": "lunar",
      "class": "lunar",
      "label": "{{2000:bar-lunar}}",
      "on_click_left": "xdg-open https://www.51wnl.com/webcalandar/index.html"
    }
  ]
}
