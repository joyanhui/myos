{
  "position": "top",
  "height": 38,
  "start": [
    { "type": "workspaces", "all_monitors": false }
  ],
  "center": [
    { "type": "focused", "icon_size": 16, "truncate": "end" }
  ],
  "end": [
    {
      "type": "sys_info",
      "name": "cpu",
      "format": ["<span size='xx-large'>󰻠</span> {cpu_percent}%"],
      "interval": { "cpu": 2 }
    },
    {
      "type": "sys_info",
      "name": "memory",
      "format": ["<span size='xx-large'>󰍛</span> {memory_percent}%"],
      "interval": { "memory": 10 }
    },
    { "type": "tray" },
    {
      "type": "volume",
      "format": "<span size='xx-large'>{icon}</span> {percentage}%",
      "max_volume": 100,
      "icons": {
        "muted": "󰝟",
        "volume_low": "󰕿",
        "volume_medium": "󰖀",
        "volume_high": "󰕾"
      }
    },
    { "type": "clock", "format": "<span size='xx-large'>󰥔</span>  %a %d %b  %H:%M" }
  ]
}
