        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT-5.6 Sol",
          "options": {
            "store": false
          },
          "variants": {
            "high": {},
            "low": {},
            "max": {},
            "medium": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT-5.6 Terra",
          "options": {
            "store": false
          },
          "variants": {
            "high": {},
            "low": {},
            "max": {},
            "medium": {},
            "xhigh": {}
          }
        }
      },
      "options": {
        "apiKey": "PLACEHOLDER_API_KEY",
        "baseURL": "https://example.invalid/placeholder"
      }
