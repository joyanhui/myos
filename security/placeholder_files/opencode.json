{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "build": {
      "options": {
        "store": false
      }
    },
    "plan": {
      "options": {
        "store": false
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "/etc/profiles/per-user/nixos/bin/google-chrome-stable",
        "--usageStatistics",
        "false"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode/mimo-v2.6-flash-free",
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "provider": {
    "LinuxDoGpt": {
      "models": {
        "gpt-5.5": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "name": "GPT-5.5",
          "options": {
            "store": false
          },
          "variants": {
            "high": {},
            "low": {},
            "max": {},
            "medium": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 1050000,
            "output": 128000
          },
