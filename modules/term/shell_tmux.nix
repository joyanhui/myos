{
  pkgs,
  username,
  ...
}:
let
  tmuxHelp = pkgs.writeShellScriptBin "tmux-help" ''
    cat <<'EOF'
    tmux 快捷键

    前缀键：Ctrl+B（每项先按一次，再按表格中的后续按键）

    ┌────────────────────────────────────┬──────────────────────────────────────────────────────┐
    │ 操作                               │ 后续按键或命令                                       │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 分屏操作                           │                                                      │
    │ 扩大分屏                           │ Ctrl+方向键                                          │
    │ 左右分屏                           │ %                                                    │
    │ 上下分屏                           │ "                                                    │
    │ 切换到下一个分屏                   │ O                                                    │
    │ 按方向切换分屏                     │ 方向键                                               │
    │ 关闭当前分屏                       │ X                                                    │
    │ 放大/还原当前分屏                  │ Z                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 标签操作                           │                                                      │
    │ 新建标签                           │ C                                                    │
    │ 下一个标签                         │ N                                                    │
    │ 上一个标签                         │ P                                                    │
    │ 切换到指定编号标签                 │ 0–9                                                 │
    │ 列出并选择标签                     │ W                                                    │
    │ 重命名当前标签                     │ ,                                                    │
    │ 关闭当前标签                       │ &                                                    │
    │ 在最近使用的两个标签间切换         │ L                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 会话快捷键                         │                                                      │
    │ 当前命令在后台继续运行             │ D                                                    │
    │ 列出并选择会话（多个会话）         │ s                                                    │
    │ 切换到上一个会话                   │ (                                                    │
    │ 切换到下一个会话                   │ )                                                    │
    │ 重命名当前会话                     │ $                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 会话管理命令                       │                                                      │
    │ 查看所有后台会话                   │ tmux ls                                              │
    │ 重新进入后台会话（单个）           │ tmux attach 或 tmux a                                │
    │ 重新进入指定会话                   │ tmux attach -t <会话名>                              │
    │ 创建并进入新会话                   │ tmux new -s <会话名>                                 │
    │ 直接后台创建会话                   │ tmux new -d -s <会话名>                              │
    │ 直接后台创建会话并运行命令         │ tmux new -d -s <会话名> '<命令>'                     │
    │ 创建或进入会话                     │ tmux new -A -s <会话名>                              │
    │ 在指定会话中运行命令               │ tmux send-keys -t <会话名> '<命令>' Enter            │
    │ 切换到指定会话                     │ tmux switch-client -t <会话名>                       │
    │ 关闭指定会话                       │ tmux kill-session -t <会话名>                        │
    └────────────────────────────────────┴──────────────────────────────────────────────────────┘
    EOF
  '';
in
{
  home-manager.users.${username} =
    { ... }:
    {
      home.packages = [ tmuxHelp ];

      programs.tmux = {
        enable = true;
        mouse = true;
        extraConfig = ''
          set -s set-clipboard on
          set -as terminal-features ',*:clipboard'
        '';
      };
    };
}
