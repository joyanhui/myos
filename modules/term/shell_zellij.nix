{
  pkgs,
  username,
  global_settings,
  ...
}:
let
  zellijHelp = pkgs.writeShellScriptBin "zellij-help" ''
    cat <<'EOF'
    Zellij 快捷键

    模式键：Ctrl + 字母（先进入模式，再按对应字母执行；Esc / Enter 返回普通模式）

    ┌────────────────────────────────────┬──────────────────────────────────────────────────────┐
    │ 操作                               │ 按键或命令                                           │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 常驻快捷键（任何模式可用）         │                                                      │
    │ 进入 / 退出锁定模式                │ Ctrl+G                                               │
    │ 新建分屏                           │ Alt+N                                                │
    │ 浮动分屏开关                       │ Alt+F                                                │
    │ 按方向切换焦点（跨标签）           │ Alt+H / Alt+L / Alt+J / Alt+K                        │
    │ 标签左移 / 右移                    │ Alt+I / Alt+O                                        │
    │ 扩大 / 缩小分屏                    │ Alt+= / Alt+-                                        │
    │ 切换预设布局                       │ Alt+[ / Alt+]                                        │
    │ 退出 zellij（终止会话）            │ Ctrl+Q                                               │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 分屏                               │ Ctrl+M（原来快捷键Ctrl+P）                           │
    │ 按方向切换焦点                     │ H / L / J / K 或方向键                               │
    │ 新建分屏（自动方向）               │ N                                                    │
    │ 上下分屏                           │ D                                                    │
    │ 左右分屏                           │ R                                                    │
    │ 堆叠分屏                           │ S                                                    │
    │ 关闭当前分屏                       │ X                                                    │
    │ 当前分屏全屏切换                   │ F                                                    │
    │ 浮动分屏开关                       │ W                                                    │
    │ 分屏在浮动与嵌入间切换             │ E                                                    │
    │ 分屏重命名                         │ C                                                    │
    │ 回到上一次的分屏                   │ ;                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 标签                               │ Ctrl+T                                               │
    │ 新建标签                           │ N                                                    │
    │ 下一个 / 上一个标签                │ L / H                                                │
    │ 切换到指定编号标签                 │ 1–9                                                  │
    │ 标签重命名                         │ R                                                    │
    │ 关闭当前标签                       │ X                                                    │
    │ 标签内容同步输入                   │ S                                                    │
    │ 把分屏拆成新标签 / 右 / 左         │ B / ] / [                                            │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 滚动与搜索                         │ Ctrl+S                                               │
    │ 上下滚动                           │ K / J 或 PageUp / PageDown                           │
    │ 半页滚动                           │ U / D                                                │
    │ 输入搜索                           │ S                                                    │
    │ 用外部编辑器看回滚内容             │ E                                                    │
    │ 复制最近一次命令输出               │ C                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 调整大小                           │ Ctrl+N                                               │
    │ 按方向扩大                         │ H / L / J / K 或方向键                               │
    │ 按方向缩小                         │ Shift+H / Shift+L / Shift+J / Shift+K                │
    │ 整体放大 / 缩小                    │ = 或 + / -                                           │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 移动分屏                           │ Ctrl+H                                               │
    │ 按方向移动当前分屏                 │ H / L / J / K 或方向键                               │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 会话                               │ Ctrl+O                                               │
    │ 断开（后台保留会话）               │ D                                                    │
    │ 会话管理器（切换 / 新建 / 关闭）   │ W                                                    │
    │ 配置查看与修改                     │ C                                                    │
    │ 插件管理器                         │ P                                                    │
    │ 布局管理器                         │ L                                                    │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ tmux 兼容模式                      │ Ctrl+B                                               │
    │ tmux 习惯键                        │ % " C N P X Z D（分屏 / 标签 / 全屏等常用）          │
    ├────────────────────────────────────┼──────────────────────────────────────────────────────┤
    │ 会话管理命令                       │                                                      │
    │ 查看所有会话                       │ zellij list-sessions（简写 zellij ls）               │
    │ 进入会话（没有就创建）             │ zellij attach -c <会话名>                            │
    │ 进入已有会话（无同名则报错）       │ zellij attach <会话名>                               │
    │ 后台创建会话                       │ zellij attach -b <会话名>                            │
    │ 新开一个命名会话                   │ zellij -s <会话名>                                   │
    │ 在会话内新开分屏运行命令           │ zellij run -- <命令>                                 │
    │ 在当前分屏内运行命令               │ zellij run --in-place -- <命令>                      │
    │ 立即关闭指定会话                   │ zellij kill-session <会话名>                         │
    │ 关闭全部会话                       │ zellij kill-all-sessions                             │
    │ 删除已复活的会话记录               │ zellij delete-session <会话名>                       │
    │ 删除全部会话记录                   │ zellij delete-all-sessions                           │
    └────────────────────────────────────┴──────────────────────────────────────────────────────┘
    EOF
  '';
in
{
  home-manager.users.${username} =
    { config, ... }:
    {
      home.packages = [
        pkgs.unstable.zellij
        zellijHelp
      ];

      xdg.configFile."zellij/config.kdl".source =
        config.lib.file.mkOutOfStoreSymlink "${global_settings.repoDir}/dotfiles/zellij_config.kdl";
    };
}
