
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
}

output "eDP-1" {
    scale 1
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.4; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.4
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        width 3
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    border {
        off
    }
    shadow {
        on
        softness 20
        spread 3
        offset x=0 y=4
        color "#0007"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "dms" "run"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user restart fcitx5"
spawn-sh-at-startup "swayidle -w timeout 600 'swaylock -f' timeout 660 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'swaylock -f'"
spawn-sh-at-startup "dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user restart xdg-desktop-portal"

binds {
    Alt+Shift+Slash { show-hotkey-overlay; }

    Alt+Return hotkey-overlay-title="终端 (ghostty)" { spawn "ghostty"; }
    Alt+Ctrl+Shift+Return hotkey-overlay-title="终端 (kitty)" { spawn "kitty"; }
    Alt+Shift+R hotkey-overlay-title="应用启动器" { spawn "rofi" "-show" "drun"; }
    Alt+Ctrl+Shift+R hotkey-overlay-title="重启输入法 (fcitx5)" { spawn "systemctl" "--user" "restart" "fcitx5"; }
    Alt+Shift+Q repeat=false { close-window; }
    Alt+Ctrl+Shift+E { quit; }

    Alt+Shift+1 { focus-workspace 1; }
    Alt+Shift+2 { focus-workspace 2; }
    Alt+Shift+3 { focus-workspace 3; }
    Alt+Shift+4 { focus-workspace 4; }
    Alt+Shift+5 { focus-workspace 5; }
    Alt+Shift+6 { focus-workspace 6; }
    Alt+Shift+7 { focus-workspace 7; }
    Alt+Shift+8 { focus-workspace 8; }
    Alt+Shift+9 { focus-workspace 9; }
    Alt+Ctrl+Shift+1 { move-column-to-workspace 1; }
    Alt+Ctrl+Shift+2 { move-column-to-workspace 2; }
    Alt+Ctrl+Shift+3 { move-column-to-workspace 3; }
    Alt+Ctrl+Shift+4 { move-column-to-workspace 4; }
    Alt+Ctrl+Shift+5 { move-column-to-workspace 5; }
    Alt+Ctrl+Shift+6 { move-column-to-workspace 6; }
    Alt+Ctrl+Shift+7 { move-column-to-workspace 7; }
    Alt+Ctrl+Shift+8 { move-column-to-workspace 8; }
    Alt+Ctrl+Shift+9 { move-column-to-workspace 9; }
    Alt+Shift+A hotkey-overlay-title="窗口切换" { spawn "rofi" "-show" "window"; }

    Alt+Shift+Left { focus-column-left; }
    Alt+Shift+Right { focus-column-right; }
    Alt+Shift+Up { focus-window-up; }
    Alt+Shift+Down { focus-window-down; }
    Alt+Ctrl+Shift+Left { move-column-left; }
    Alt+Ctrl+Shift+Right { move-column-right; }
    Alt+Ctrl+Shift+Up { move-window-up; }
    Alt+Ctrl+Shift+Down { move-window-down; }

    Alt+Shift+F { maximize-column; }
    Alt+Ctrl+Shift+F { fullscreen-window; }
    Alt+Shift+M { maximize-window-to-edges; }
    Alt+Shift+V { toggle-window-floating; }
    Alt+Ctrl+Shift+V { switch-focus-between-floating-and-tiling; }
    Alt+Shift+W { toggle-column-tabbed-display; }
    Alt+Ctrl+Shift+W { switch-preset-column-width; }
    Alt+Shift+H { reset-window-height; }
    Alt+Minus { set-column-width "-10%"; }
    Alt+Equal { set-column-width "+10%"; }
    Alt+Shift+Minus { set-window-height "-10%"; }
    Alt+Shift+Equal { set-window-height "+10%"; }
    Alt+Comma { consume-window-into-column; }
    Alt+Period { expel-window-from-column; }
    Alt+BracketLeft { consume-or-expel-window-left; }
    Alt+BracketRight { consume-or-expel-window-right; }
    Alt+Shift+C { center-column; }

    Alt+Shift+O repeat=false { toggle-overview; }
    Alt+Shift+S { screenshot; }
    Alt+Shift+Print { screenshot-screen; }
    Alt+Ctrl+Shift+Print { screenshot-window; }

    Alt+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Alt+Ctrl+Shift+P { power-off-monitors; }
}
